{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astrovela.github.io/vane-extensions/schema/extension.schema.json",
  "title": "Vane extension registry manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "extension_name",
    "distribution_name",
    "description",
    "repository",
    "publisher",
    "license",
    "maintainers",
    "package_index",
    "documentation"
  ],
  "properties": {
    "$schema": {
      "const": "../../schema/extension.schema.json"
    },
    "extension_name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$",
      "maxLength": 128
    },
    "distribution_name": {
      "type": "string",
      "pattern": "^vane-extension-[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "maxLength": 256
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^(?!\\s)(?!.*\\s$)[^\\u0000-\\u001f\\u007f\\ud800-\\udfff]+$"
    },
    "repository": {
      "type": "string",
      "format": "uri",
      "pattern": "^(?!.*\\.git$)https://github\\.com/[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?/[A-Za-z0-9_.-]{1,100}$",
      "maxLength": 2048
    },
    "publisher": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^(?!\\s)(?!.*\\s$)[^\\u0000-\\u001f\\u007f\\ud800-\\udfff]+$"
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^(?!\\s)(?!.*\\s$)[^\\u0000-\\u001f\\u007f\\ud800-\\udfff]+$"
    },
    "maintainers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$",
        "maxLength": 39
      }
    },
    "package_index": {
      "enum": [
        "pypi",
        "testpypi"
      ]
    },
    "documentation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "hello_world",
        "extended_description"
      ],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^(?=[\\u0021-\\u007e]+$)https://",
          "maxLength": 2048
        },
        "hello_world": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000,
          "pattern": "^(?!\\s)(?![\\s\\S]*\\s$)(?![\\s\\S]*[\\u0000-\\u0009\\u000b-\\u001f\\u007f\\ud800-\\udfff])[\\s\\S]+$"
        },
        "extended_description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000,
          "pattern": "^(?!\\s)(?![\\s\\S]*\\s$)(?![\\s\\S]*[\\u0000-\\u0009\\u000b-\\u001f\\u007f\\ud800-\\udfff])[\\s\\S]+$"
        }
      }
    }
  }
}
