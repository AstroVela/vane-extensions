{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astrovela.github.io/vane-extensions/schema/extension.schema.json",
  "title": "Vane extension registry manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "extension_name",
    "distribution_name",
    "description",
    "repository",
    "publisher",
    "license"
  ],
  "properties": {
    "$schema": {
      "const": "../../schema/extension.schema.json"
    },
    "extension_name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$",
      "maxLength": 128
    },
    "distribution_name": {
      "type": "string",
      "pattern": "^vane-extension-[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "maxLength": 256
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^(?!\\s)(?!.*\\s$)[^\\u0000-\\u001f\\u007f\\ud800-\\udfff]+$"
    },
    "repository": {
      "type": "string",
      "format": "uri",
      "pattern": "^(?=[\\u0021-\\u007e]+$)https://(?:\\[[^\\]@/?#]+\\]|[^@:/?#]+)/[^?#]+$",
      "maxLength": 2048
    },
    "publisher": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^(?!\\s)(?!.*\\s$)[^\\u0000-\\u001f\\u007f\\ud800-\\udfff]+$"
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^(?!\\s)(?!.*\\s$)[^\\u0000-\\u001f\\u007f\\ud800-\\udfff]+$"
    }
  }
}
