{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astrovela.github.io/vane-extensions/schema/extension-detail.schema.json",
  "title": "Enriched Vane extension detail",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "format_version",
    "generated_at",
    "extension_name",
    "distribution_name",
    "description",
    "repository",
    "publisher",
    "license",
    "maintainers",
    "documentation",
    "source",
    "package",
    "installation",
    "metrics"
  ],
  "properties": {
    "$schema": {
      "const": "../../schema/extension-detail.schema.json"
    },
    "format_version": {
      "const": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "extension_name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$",
      "maxLength": 128
    },
    "distribution_name": {
      "type": "string",
      "pattern": "^vane-extension-[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "maxLength": 256
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "repository": {
      "type": "string",
      "format": "uri",
      "pattern": "^(?!.*\\.git$)https://github\\.com/[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?/[A-Za-z0-9_.-]{1,100}$"
    },
    "publisher": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "maintainers": {
      "$ref": "#/$defs/maintainers"
    },
    "documentation": {
      "$ref": "#/$defs/documentation"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "package": {
      "$ref": "#/$defs/package"
    },
    "installation": {
      "$ref": "#/$defs/installation"
    },
    "metrics": {
      "$ref": "#/$defs/metrics"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "package": {
            "properties": {
              "index": {
                "const": "testpypi"
              }
            },
            "required": [
              "index"
            ]
          }
        },
        "required": [
          "package"
        ]
      },
      "then": {
        "properties": {
          "metrics": {
            "properties": {
              "downloads_last_week": {
                "type": "null"
              },
              "source": {
                "type": "null"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "package": {
            "properties": {
              "published": {
                "const": false
              }
            },
            "required": [
              "published"
            ]
          }
        },
        "required": [
          "package"
        ]
      },
      "then": {
        "properties": {
          "installation": {
            "properties": {
              "install_commands": {
                "maxItems": 0
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "installation": {
            "properties": {
              "install_commands": {
                "minItems": 1
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "maintainers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$",
        "maxLength": 39
      }
    },
    "documentation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "hello_world",
        "extended_description"
      ],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "hello_world": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "extended_description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "github_stars"
      ],
      "properties": {
        "github_stars": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "project_url",
        "published",
        "latest_version",
        "requires_python",
        "requires_dist",
        "wheel_count",
        "python_versions",
        "python_tags",
        "abi_tags",
        "platform_tags",
        "latest_release_uploaded_at"
      ],
      "properties": {
        "index": {
          "enum": [
            "pypi",
            "testpypi"
          ]
        },
        "project_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://(?:test\\.)?pypi\\.org/project/"
        },
        "published": {
          "type": "boolean"
        },
        "latest_version": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 4096
        },
        "requires_python": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 4096
        },
        "requires_dist": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "wheel_count": {
          "type": "integer",
          "minimum": 0
        },
        "python_versions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+$"
          }
        },
        "python_tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.]+$"
          }
        },
        "abi_tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.]+$"
          }
        },
        "platform_tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.]+$"
          }
        },
        "latest_release_uploaded_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "published": {
                "const": false
              }
            },
            "required": [
              "published"
            ]
          },
          "then": {
            "properties": {
              "latest_version": {
                "type": "null"
              },
              "requires_python": {
                "type": "null"
              },
              "requires_dist": {
                "maxItems": 0
              },
              "wheel_count": {
                "const": 0
              },
              "python_versions": {
                "maxItems": 0
              },
              "python_tags": {
                "maxItems": 0
              },
              "abi_tags": {
                "maxItems": 0
              },
              "platform_tags": {
                "maxItems": 0
              },
              "latest_release_uploaded_at": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "latest_version": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "installation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "install_commands",
        "load_example"
      ],
      "properties": {
        "install_commands": {
          "type": "array",
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "load_example": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "downloads_last_week",
        "source"
      ],
      "properties": {
        "downloads_last_week": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "source": {
          "enum": [
            "pypistats.org",
            null
          ]
        }
      },
      "oneOf": [
        {
          "properties": {
            "downloads_last_week": {
              "type": "integer"
            },
            "source": {
              "const": "pypistats.org"
            }
          }
        },
        {
          "properties": {
            "downloads_last_week": {
              "type": "null"
            },
            "source": {
              "type": "null"
            }
          }
        }
      ]
    }
  }
}
